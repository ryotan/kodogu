{
  "sandbox": {
    "network": {
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "mise run test*",
      "mise run --continue-on-error test*",
      "mise run -c test*",
      "mise run app:test*",
      "bunx vitest*"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-fmt.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-fix.sh"
          }
        ]
      }
    ]
  }
}

{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  addLabels: [
    'dependencies',
  ],
  commitMessagePrefix: '⬆️(deps): ',
  extends: [
    // `config:best-practices` bundles config:recommended + helpers:pinGitHubActionDigests + docker:pinDigests
    // + :configMigration + :pinDevDependencies + security:minimumReleaseAgeNpm + :maintainLockFilesWeekly
    // + abandonments:recommended. The `:pinAllExceptPeerDependencies` preset escalates pinning from
    // best-practices' devDeps-only default to "everything except `peerDependencies` and `engines`".
    'config:best-practices',
    ':pinAllExceptPeerDependencies',
  ],
  timezone: 'Asia/Tokyo',
  // Mitigate supply-chain attacks by only considering versions that have been released for at least 1 week.
  minimumReleaseAge: '7 days',
  // Suppress branch/PR creation while a version is still inside the minimumReleaseAge window.
  //   cf. https://docs.renovatebot.com/key-concepts/minimum-release-age/#recommended-settings
  internalChecksFilter: 'strict',
  // Use the OSV database (osv.dev) for vulnerability alerts in addition to the GitHub Advisory Database.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    // Bypass minimumReleaseAge for security alerts (CVEs) so they are applied immediately.
    minimumReleaseAge: '0 days',
  },
  packageRules: [
    {
      // `security:minimumReleaseAgeNpm` (pulled in via `config:best-practices`) sets the npm cooldown to
      // 3 days. Override back to 7 days so npm shares the same cooldown invariant as every other datasource.
      matchDatasources: [
        'npm',
      ],
      minimumReleaseAge: '7 days',
    },
    {
      // Pin / pinDigest / replacement updates do not introduce new code: pin converts an existing
      // range to an exact version, pinDigest fixes an existing action reference to a SHA, and
      // replacement swaps to a maintained successor at an already-allowed version. The release-age
      // check is irrelevant in all three cases — and worse, the pin / pinDigest paths don't wire in
      // the release timestamp at all, so any non-null `minimumReleaseAge` leaves the check in
      // pending status forever (with default `minimumReleaseAgeBehaviour: 'timestamp-required'`).
      // Setting it to `null` disables the check rather than just lowering the threshold.
      // `security:minimumReleaseAgeNpm` (pulled in via `config:best-practices`) does the equivalent
      // for npm only; this rule covers the rest.
      matchUpdateTypes: [
        'pin',
        'pinDigest',
        'replacement',
      ],
      minimumReleaseAge: null,
    },
    {
      // Suppress all digest update PRs. `helpers:pinGitHubActionDigests` and `docker:pinDigests` (both
      // pulled in via `config:best-practices`) pin references to SHAs and then keep proposing digest bumps,
      // but every new digest commit is by definition freshly published, so it can never satisfy the 7-day
      // `minimumReleaseAge` window — and the digest update path doesn't wire in the release timestamp
      // anyway, so the check would stay in pending status forever regardless of the configured value.
      // Cooldown is structurally unavailable for digest updates, so we suppress them entirely. The
      // defenses we still have:
      //   - The SHA pin itself (deps are immutable between bumps)
      //   - Real version bumps (major/minor/patch) still flow and are subject to the normal 7-day cooldown
      //   - CVE-tracked issues bypass cooldown via `vulnerabilityAlerts`
      matchUpdateTypes: [
        'digest',
      ],
      enabled: false,
    },
    {
      // Disable scheduled lockFileMaintenance for cargo. The maintenance step delegates to `cargo update`,
      // which has no native release-age filter, so the weekly run would silently pull in transitive versions
      // that are still inside the 7-day `minimumReleaseAge` window. Direct dependency bumps still flow through
      // Renovate's regular PRs (which respect cooldown) and refresh Cargo.lock as part of that work; CVE-tracked
      // transitives bypass cooldown via `vulnerabilityAlerts`. The trade-off is slower transitive refresh,
      // which we accept in exchange for keeping the cooldown invariant.
      matchManagers: [
        'cargo',
      ],
      lockFileMaintenance: {
        enabled: false,
      },
    },
    {
      // RustCrypto crates share traits crates (cipher, digest, aead) and break in lock-step on
      // trait-version bumps, so update them as one PR. This rule is the future-proof primary
      // matcher: any crate that Renovate's cargo datasource exposes with a `sourceUrl` under
      // `RustCrypto/` lands here, including ones added to the workspace later.
      groupName: 'RustCrypto stack',
      matchSourceUrls: [
        'https://github.com/RustCrypto/**',
      ],
    },
    {
      // Fallback bucket for three reasons:
      //   1. Renovate's cargo datasource sometimes leaves `sourceUrl` unset — it only gets
      //      populated reliably when crates.io `repository` is a subdirectory URL (e.g.
      //      `RustCrypto/password-hashes/tree/master/pbkdf2`). Crates whose `repository` is
      //      the repo root (e.g. `RustCrypto/MACs`) end up without sourceUrl, so the
      //      matchSourceUrls rule above misses them.
      //   2. ed25519-dalek lives under dalek-cryptography on GitHub but is tightly coupled
      //      to the RustCrypto trait stack (sha2/digest/ed25519/pkcs8/signature/spki) and
      //      should bump in lock-step with the rest of the group.
      //   3. rand (rust-random) internally pins its chacha20 dependency to a specific major
      //      version — bumping rand's major without bumping chacha20's forces a duplicated
      //      trait generation (cipher 0.4 vs 0.5, crypto-common 0.1 vs 0.2, etc.) in
      //      Cargo.lock.
      // Keep this list in sync with the relevant crates in the workspace.
      // cf. https://github.com/renovatebot/renovate/issues/3486
      //     https://github.com/renovatebot/renovate/issues/37537
      groupName: 'RustCrypto stack',
      matchPackageNames: [
        // RustCrypto
        'aes',
        'aes-gcm',
        'aes-gcm-siv',
        'argon2',
        'bcrypt-pbkdf',
        'cbc',
        'chacha20',
        'chacha20poly1305',
        'cmac',
        'concat-kdf',
        'ctr',
        'hex-literal',
        'hkdf',
        'hmac',
        'p256',
        'p384',
        'pbkdf2',
        'pkcs8',
        'poly1305',
        'rsa',
        'scrypt',
        'sha2',
        'zeroize',
        // dalek-cryptography (shares the RustCrypto trait stack)
        'ed25519-dalek',
        // rust-random (rand's major is internally pinned to chacha20's major)
        'rand',
      ],
    },
    {
      // Tauri requires the Rust crates and JS packages to share the same version, so update them together.
      groupName: 'Tauri',
      matchPackageNames: [
        '@tauri-apps/*',
        'tauri',
        'tauri-build',
        'tauri-plugin-*',
      ],
    },
    {
      // Update TanStack packages together.
      // Note: `@tanstack/eslint-plugin-*` is reassigned to the ESLint group by a later rule.
      groupName: 'TanStack',
      matchPackageNames: [
        '@tanstack/*',
      ],
    },
    {
      // Vitest, its official plugins, and the peer-dependent playwright must share versions,
      // so update them together.
      // Note: `@vitest/eslint-plugin` is reassigned to the ESLint group by a later rule.
      groupName: 'Vitest',
      matchPackageNames: [
        '@vitest/*',
        'playwright',
        'vitest',
        'vitest-browser-react',
      ],
    },
    {
      // Update Radix UI packages together.
      groupName: 'Radix UI',
      matchPackageNames: [
        '@radix-ui/*',
      ],
    },
    {
      // Update React together with its type definitions (@types/react, @types/react-dom).
      groupName: 'React',
      matchPackageNames: [
        '@types/react',
        '@types/react-dom',
        'react',
        'react-dom',
      ],
    },
    {
      // Update Vite together with its plugins.
      groupName: 'Vite',
      matchPackageNames: [
        '@vitejs/*',
        'vite',
        'vite-tsconfig-paths',
      ],
    },
    {
      // Update `tracing` and `tracing-subscriber` together to keep API compatibility.
      groupName: 'tracing',
      matchPackageNames: [
        'tracing',
        'tracing-subscriber',
      ],
    },
    {
      // `data-encoding-macro` pins `data-encoding`'s exact major (e.g. 0.1.20 requires `^2.11`),
      // and the three crates are co-published from the same repo on the same day. Updating them
      // individually risks transient lock-resolution failures because we pin exact versions in
      // `Cargo.toml`; group them so a single PR bumps the set together.
      groupName: 'data-encoding',
      matchPackageNames: [
        'data-encoding',
        'data-encoding-macro',
        'data-encoding-macro-internal',
      ],
    },
    {
      // `serde` couples tightly with `serde_derive` (via the `derive` feature) and `serde_json`
      // shares its release cadence. Update the whole serde-rs family together so a `serde` major
      // bump cannot land while companion crates lag behind.
      groupName: 'serde',
      matchSourceUrls: [
        'https://github.com/serde-rs/**',
      ],
    },
    {
      // ESLint major upgrades (v9 → v10 etc.) require all plugins to follow the new plugin API,
      // so update ESLint and its plugins together.
      // Note: `eslint-plugin-storybook` is reassigned to the Storybook group by a later rule.
      groupName: 'ESLint',
      matchPackageNames: [
        '@eslint/*',
        '@tanstack/eslint-plugin-*',
        '@vitest/eslint-plugin',
        'eslint',
        'eslint-plugin-*',
        'typescript-eslint',
      ],
    },
    {
      // Storybook packages must share the same version, otherwise Storybook can fail to start.
      // Update them together.
      groupName: 'Storybook',
      matchPackageNames: [
        '@chromatic-com/storybook',
        '@storybook/*',
        'eslint-plugin-storybook',
        'storybook',
      ],
    },
  ],
}

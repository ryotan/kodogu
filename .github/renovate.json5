{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  addLabels: [
    'dependencies',
  ],
  commitMessagePrefix: '⬆️(deps): ',
  extends: [
    'config:recommended',
    ':preserveSemverRanges',
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Asia/Tokyo',
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 20:00 on saturday',
    ],
  },
  packageRules: [
    // chacha20poly1305 requires chacha20 ^0.9, so upgrading chacha20 alone breaks Cargo.lock update
    {
      matchPackageNames: ['chacha20', 'chacha20poly1305'],
      groupName: 'chacha20 packages',
    },
    // aes-gcm and aes-gcm-siv require aes ^0.8, so upgrading aes alone breaks Cargo.lock update
    {
      matchPackageNames: ['aes', 'aes-gcm', 'aes-gcm-siv'],
      groupName: 'aes packages',
    },
    // hkdf/pbkdf2 require hmac ^0.12, bcrypt-pbkdf/scrypt require pbkdf2 ^0.12 and sha2 ^0.10
    {
      matchPackageNames: ['hmac', 'sha2', 'hkdf', 'pbkdf2', 'bcrypt-pbkdf', 'scrypt'],
      groupName: 'digest/kdf packages',
    },
  ],
}

{
  "compilerOptions": {
    "composite": true,
    "lib": ["es2020"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", ".storybook/main.ts", ".storybook/vitest.setup.ts", ".storybook/preview.tsx", ".storybook/tauri-api-stub.ts"]
}

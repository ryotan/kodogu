{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and popover windows",
  "windows": ["main", "popover"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "opener:default",
    "deep-link:default",
    "http:default",
    "stronghold:default",
    "window-state:default"
  ]
}

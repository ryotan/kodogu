{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KoDoGu (Dev)",
  "version": "0.1.0",
  "identifier": "pw.itr0.kodogu.app.dev",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "url": "/popover",
        "title": "",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "resizable": false,
        "width": 480,
        "height": 480,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "preventOverflow": true,
        "acceptFirstMouse": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pw.itr0.kodogu.app.dev"
        ]
      }
    }
  }
}

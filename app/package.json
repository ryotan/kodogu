{
  "name": "kodogu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build --config src-tauri/tauri.prod.conf.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "concurrently 'bun:lint:*'",
    "lint:es": "eslint .",
    "lint:tsc": "tsc --noEmit -p tsconfig.app.json",
    "lint:biome": "biome ci --error-on-warnings .",
    "lint:cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint:cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --no-deps --all-features --all-targets",
    "fix": "concurrently 'concurrently -m 1 bun:fix:es bun:fix:biome' 'bun:fix:cargo:*'",
    "fix:es": "eslint --fix .",
    "fix:biome": "biome check --write --unsafe .",
    "fix:cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fix:cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --fix --all-features --all-targets --allow-dirty --allow-staged"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "@tanstack/react-form": "^1.1.2",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-router": "^1.114.25",
    "@tanstack/react-store": "^0.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.2",
    "@tauri-apps/plugin-deep-link": "^2.2.0",
    "@tauri-apps/plugin-http": "^2.4.2",
    "@tauri-apps/plugin-log": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-stronghold": "^2.2.0",
    "@tauri-apps/plugin-window-state": "^2.2.1",
    "arktype": "^2.1.10",
    "immer": "^10.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@chromatic-com/storybook": "3",
    "@eslint/compat": "^1.2.7",
    "@eslint/js": "^9.22.0",
    "@storybook/addon-essentials": "8.6.7",
    "@storybook/addon-onboarding": "8.6.7",
    "@storybook/blocks": "8.6.7",
    "@storybook/experimental-addon-test": "8.6.7",
    "@storybook/react": "8.6.7",
    "@storybook/react-vite": "8.6.7",
    "@storybook/test": "8.6.7",
    "@tanstack/eslint-plugin-query": "^5.68.0",
    "@tanstack/eslint-plugin-router": "^1.114.12",
    "@tanstack/react-query-devtools": "^5.69.0",
    "@tanstack/react-router-devtools": "^1.114.25",
    "@tanstack/router-plugin": "^1.114.25",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.0.9",
    "@vitest/coverage-v8": "^3.0.9",
    "@vitest/eslint-plugin": "^1.1.38",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^0.11.6",
    "playwright": "^1.51.1",
    "storybook": "8.6.7",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.27.0",
    "vite": "^6.2.2",
    "vite-tsconfig-paths": "^5.1.4",

{
  "name": "kodogu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build --config src-tauri/tauri.prod.conf.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "concurrently 'bun:lint:*'",
    "lint:es": "eslint .",
    "lint:tsc": "tsc --noEmit -p tsconfig.app.json",
    "lint:biome": "biome ci --error-on-warnings .",
    "lint:cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint:cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --no-deps --all-features --all-targets --release",
    "fix": "concurrently 'concurrently -m 1 bun:fix:es bun:fix:biome' 'bun:fix:cargo:*'",
    "fix:es": "eslint --fix .",
    "fix:biome": "biome check --write --unsafe .",
    "fix:cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fix:cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --fix --all-features --all-targets --allow-dirty --allow-staged",
    "test": "concurrently bun:test:vitest bun:test:cargo",
    "test:coverage": "concurrently bun:test:vitest:coverage bun:test:cargo:coverage",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:vitest:coverage": "vitest run --coverage",
    "test:cargo": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --workspace",
    "test:cargo:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --all-features --workspace --lcov --output-path lcov.info"
  },
  "dependencies": {
    "@radix-ui/react-icons": "catalog:default",
    "@radix-ui/themes": "catalog:default",
    "@tanstack/react-form": "catalog:default",
    "@tanstack/react-query": "catalog:default",
    "@tanstack/react-router": "catalog:default",
    "@tanstack/react-store": "catalog:default",
    "@tauri-apps/api": "catalog:default",
    "@tauri-apps/plugin-clipboard-manager": "catalog:default",
    "@tauri-apps/plugin-deep-link": "catalog:default",
    "@tauri-apps/plugin-http": "catalog:default",
    "@tauri-apps/plugin-opener": "catalog:default",
    "@tauri-apps/plugin-window-state": "catalog:default",
    "arktype": "catalog:default",
    "mutative": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-error-boundary": "catalog:default"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:default",
    "@chromatic-com/storybook": "catalog:default",
    "@eslint/compat": "catalog:default",
    "@eslint/js": "catalog:default",
    "@storybook/addon-a11y": "catalog:default",
    "@storybook/addon-docs": "catalog:default",
    "@storybook/addon-onboarding": "catalog:default",
    "@storybook/addon-vitest": "catalog:default",
    "@storybook/react-vite": "catalog:default",
    "@tanstack/eslint-plugin-query": "catalog:default",
    "@tanstack/eslint-plugin-router": "catalog:default",
    "@tanstack/react-query-devtools": "catalog:default",
    "@tanstack/react-router-devtools": "catalog:default",
    "@tanstack/router-plugin": "catalog:default",
    "@tauri-apps/cli": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "@vitejs/plugin-react": "catalog:default",
    "@vitest/browser-playwright": "catalog:default",
    "@vitest/coverage-v8": "catalog:default",
    "@vitest/eslint-plugin": "catalog:default",
    "concurrently": "catalog:default",
    "eslint": "catalog:default",
    "eslint-plugin-react": "catalog:default",
    "eslint-plugin-react-hooks": "catalog:default",
    "eslint-plugin-storybook": "catalog:default",
    "storybook": "catalog:default",
    "typescript": "catalog:default",
    "typescript-eslint": "catalog:default",
    "vite": "catalog:default",
    "vite-tsconfig-paths": "catalog:default",
    "vitest": "catalog:default",
    "vitest-browser-react": "catalog:default"
  }
}

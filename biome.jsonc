{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              // builtin
              ":BUN:",
              ":NODE:",
              // external (specific)
              ":BLANK_LINE:",
              ["vite*", "vite*/**", "@vite*/**"],
              ":BLANK_LINE:",
              ["react", "react-dom", "react-dom*/**"],
              ":BLANK_LINE:",
              ["tanstack*", "tanstack*/**", "@tanstack*/**"],
              ":BLANK_LINE:",
              ["radix-ui*", "radix-ui*/**", "@radix-ui*/**"],
              // external
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":URL:",
              ":PACKAGE_WITH_PROTOCOL:",
              // internal
              ":BLANK_LINE:",
              // sources starting with #, @/, ~, $, or %.
              ":ALIAS:",
              // path (parent)
              ":BLANK_LINE:",
              ["..", "../**"],
              // path (sibling, index, absolute)
              ":BLANK_LINE:",
              [".", "./**"],
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        // react-hooks/rules-of-hooksの代替にはならないので、無効にしておく。
        // （Reactコンポーネントもしくはカスタムフック以外でuseXXXを呼んでもエラーにならない）
        "useHookAtTopLevel": "off",
        // react-hooks/exhaustive-depsの代替にはならないので、無効にしておく。
        // （依存変数配列を自動では修正してくれない）
        "useExhaustiveDependencies": "off",
        "noUndeclaredDependencies": {
          "level": "error",
          "options": {
            "devDependencies": [
              "**/*.test.*",
              "**/*.spec.*",
              "**/*.stories.*",
              "**/*.fixture.*",
              "**/_dev/**",
              "**/(dev)/**",
              "**/eslint.config.mjs",
              "**/vite.config.ts",
              "**/vitest.workspace.ts",
              "**/.storybook/**"
            ]
          }
        }
      },
      "complexity": {
        // @typescript-eslint/dot-notation
        "useLiteralKeys": "error",
        // @typescript-eslint/prefer-optional-chain
        "useOptionalChain": "error",
        // react/jsx-no-useless-fragment
        "noUselessFragments": "error",
        "noVoid": "error"
      },
      "style": {
        // Next.jsやExpo Routerの規約上、default exportが必要
        "noDefaultExport": "off",
        "noNamespace": "error",
        "noNegationElse": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useConsistentArrayType": "error",
        "useForOf": "error",
        "useFragmentSyntax": "error",
        // Next.jsやExpo Routerのファイル命名規約に従えない（[fragment].tsxや+html.tsxなど）
        "useFilenamingConvention": {
          "level": "off",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true,
            "strictCase": true
          }
        },
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        // React Componentの命名規約（PascalCase）が守れなくなるので無効にしておく
        "useNamingConvention": {
          "level": "off",
          "options": {
            "conventions": [
              {
                "selector": { "kind": "enumMember" },
                "formats": ["CONSTANT_CASE"]
              }
            ],
            "strictCase": false,
            "requireAscii": false
          }
        },
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useConsistentCurlyBraces": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error"
      },
      "nursery": {}
    }
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "arrowParentheses": "asNeeded",
      "bracketSameLine": false,
      "bracketSpacing": false,
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/.idea", "!**/.github", "!**/patches", "!**/src-tauri", "!kernel"],
    "ignoreUnknown": true
  }
}

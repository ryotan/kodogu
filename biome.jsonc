{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              // builtin
              ":BUN:",
              ":NODE:",
              // external (specific)
              ":BLANK_LINE:",
              ["vite*", "vite*/**", "@vite*/**"],
              ":BLANK_LINE:",
              ["react", "react-dom", "react-dom*/**"],
              ":BLANK_LINE:",
              ["tanstack*", "tanstack*/**", "@tanstack*/**"],
              ":BLANK_LINE:",
              ["radix-ui*", "radix-ui*/**", "@radix-ui*/**"],
              // external
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":URL:",
              ":PACKAGE_WITH_PROTOCOL:",
              // internal
              ":BLANK_LINE:",
              // sources starting with #, @/, ~, $, or %.
              ":ALIAS:",
              // path (parent)
              ":BLANK_LINE:",
              ["..", "../**"],
              // path (sibling, index, absolute)
              ":BLANK_LINE:",
              [".", "./**"],
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        // Hook rules are left to ESLint's react-hooks.
        "useHookAtTopLevel": "off",
        "useExhaustiveDependencies": "off",
        "noUndeclaredDependencies": {
          "level": "error",
          "options": {
            "devDependencies": [
              "**/*.test.*",
              "**/*.spec.*",
              "**/*.stories.*",
              "**/_dev/**",
              "**/(dev)/**",
              "**/eslint.config.mjs",
              "**/vite.config.ts",
              "**/vitest.workspace.ts",
              "**/.storybook/**"
            ]
          }
        }
      },
      "complexity": {
        // @typescript-eslint/dot-notation
        "useLiteralKeys": "error",
        // @typescript-eslint/prefer-optional-chain
        "useOptionalChain": "error",
        // react/jsx-no-useless-fragment
        "noUselessFragments": "error",
        "noVoid": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useConsistentArrayType": "error",
        "useForOf": "error",
        "useFragmentSyntax": "error",
        // File names follow their export names: PascalCase components, camelCase hooks.
        "useFilenamingConvention": "off",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        // Components are PascalCase even as object properties.
        "useNamingConvention": "off",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useConsistentCurlyBraces": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error"
      },
      "nursery": {}
    }
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "arrowParentheses": "asNeeded",
      "bracketSameLine": false,
      "bracketSpacing": false,
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/.idea", "!**/.github", "!**/patches", "!**/src-tauri", "!app/gen", "!kernel", "!**/*.svg"],
    "ignoreUnknown": true
  },
  "overrides": [
    {
      // Storybook meta and these tool configs must be default exports.
      "includes": [
        "**/*.stories.*",
        "**/.storybook/main.ts",
        "**/.storybook/preview.tsx",
        "**/vite.config.ts",
        "**/eslint.config.mjs"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}

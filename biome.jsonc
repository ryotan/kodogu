{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              // builtin
              ":BUN:",
              ":NODE:",
              // external (specific)
              ":BLANK_LINE:",
              ["vite*", "vite*/**", "@vite*/**"],
              ":BLANK_LINE:",
              ["react", "react-dom", "react-dom*/**"],
              ":BLANK_LINE:",
              ["tanstack*", "tanstack*/**", "@tanstack*/**"],
              ":BLANK_LINE:",
              ["radix-ui*", "radix-ui*/**", "@radix-ui*/**"],
              // external
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":URL:",
              ":PACKAGE_WITH_PROTOCOL:",
              // internal
              ":BLANK_LINE:",
              // sources starting with #, @/, ~, $, or %.
              ":ALIAS:",
              // path (parent)
              ":BLANK_LINE:",
              ["..", "../**"],
              // path (sibling, index, absolute)
              ":BLANK_LINE:",
              [".", "./**"],
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        // Hook rules are left to ESLint's react-hooks.
        "useHookAtTopLevel": "off",
        "useExhaustiveDependencies": "off",
        "noUndeclaredDependencies": {
          "level": "error",
          "options": {
            "devDependencies": [
              "**/*.test.*",
              "**/*.spec.*",
              "**/*.story.*",
              "**/_dev/**",
              "**/(dev)/**",
              "**/eslint.config.mjs",
              "**/vitest.config.mjs",
              "**/vitest.config.ts",
              "**/vite.config.ts",
              "**/vitest.workspace.ts",
              "**/.storybook/**"
            ]
          }
        }
      },
      "complexity": {
        // @typescript-eslint/dot-notation
        "useLiteralKeys": "error",
        // @typescript-eslint/prefer-optional-chain
        "useOptionalChain": "error",
        // react/jsx-no-useless-fragment
        "noUselessFragments": "error",
        "noVoid": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useConsistentArrayType": "error",
        "useForOf": "error",
        "useFragmentSyntax": "error",
        // File names follow their export names: PascalCase components, camelCase hooks.
        "useFilenamingConvention": "off",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        // Components are PascalCase even as object properties.
        "useNamingConvention": "off",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useConsistentCurlyBraces": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error"
      },
      "nursery": {}
    }
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "arrowParentheses": "asNeeded",
      "bracketSameLine": false,
      "bracketSpacing": false,
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.idea",
      "!**/.github",
      "!**/patches",
      "!**/src-tauri",
      "!apps/desktop/routing/gen",
      // Its imports break the rules on purpose; `lint:deps:fixtures` checks them.
      "!apps/desktop/dependency-fixtures",
      "!kernel",
      "!**/*.svg"
    ],
    "ignoreUnknown": true
  },
  "overrides": [
    {
      // Storybook meta and these tool configs must be default exports.
      "includes": [
        "**/*.story.*",
        "**/.storybook/main.ts",
        "**/.storybook/preview.tsx",
        "**/vite.config.ts",
        "**/vitest.config.mjs",
        "**/vitest.config.ts",
        "**/eslint.config.mjs"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    // The directions of imports inside a package of the desktop app. Each file matches one of these overrides at most,
    // because where two match, the later one replaces the patterns of the earlier; so each holds every pattern for its
    // files. Tests, stories, fixtures and the shared preview of Storybook match none: they may import what the package
    // may.
    // Every other file of a package of the desktop app
    {
      "includes": [
        "apps/desktop/*/src/**",
        "tools/*/desktop/src/**",
        "apps/desktop/routing/src/**",
        "apps/desktop/dependency-fixtures/routing/src/**",
        "!apps/desktop/*/src/hooks/**",
        "!tools/*/desktop/src/hooks/**",
        "!apps/desktop/*/src/loaders/**",
        "!tools/*/desktop/src/loaders/**",
        "!apps/desktop/*/src/commands/**",
        "!tools/*/desktop/src/commands/**",
        "!apps/desktop/*/src/components/**",
        "!tools/*/desktop/src/components/**",
        "!apps/desktop/*/src/screens/**",
        "!tools/*/desktop/src/screens/**",
        "!apps/desktop/*/src/(dev)/**",
        "!tools/*/desktop/src/(dev)/**",
        "!apps/desktop/*/src/(prototype)/**",
        "!tools/*/desktop/src/(prototype)/**",
        "!apps/desktop/routing/src/**",
        "!apps/desktop/dependency-fixtures/routing/src/**",
        "apps/desktop/routing/src/router.ts",
        "apps/desktop/dependency-fixtures/routing/src/router.ts",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.story.*",
        "!**/*.fixture.*",
        "!apps/desktop/foundation/src/storybook/**",
        "!apps/desktop/dependency-fixtures/src/storybook/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#(dev)/**", "#(dev)", "./**/(dev)/**", "./**/(dev)", "../**/(dev)/**", "../**/(dev)"],
                    "message": "Only screens import (dev)/."
                  },
                  {
                    "group": [
                      "#(prototype)/**",
                      "#(prototype)",
                      "./**/(prototype)/**",
                      "./**/(prototype)",
                      "../**/(prototype)/**",
                      "../**/(prototype)"
                    ],
                    "message": "Only screens import (prototype)/."
                  },
                  {
                    "group": [
                      "**/*.test",
                      "**/*.test.*",
                      "**/*.spec",
                      "**/*.spec.*",
                      "**/*.story",
                      "**/*.story.*",
                      "**/*.fixture",
                      "**/*.fixture.*",
                      "#storybook/**",
                      "#storybook",
                      "./**/storybook/**",
                      "./**/storybook",
                      "../**/storybook/**",
                      "../**/storybook",
                      "@kodogu/desktop-foundation/storybook/**",
                      "@kodogu/desktop-foundation/storybook"
                    ],
                    "message": "Production code may not import tests, stories, fixtures or the shared preview of Storybook."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Hooks and loaders
    {
      "includes": [
        "apps/desktop/*/src/hooks/**",
        "tools/*/desktop/src/hooks/**",
        "apps/desktop/*/src/loaders/**",
        "tools/*/desktop/src/loaders/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.story.*",
        "!**/*.fixture.*",
        "!apps/desktop/foundation/src/storybook/**",
        "!apps/desktop/dependency-fixtures/src/storybook/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#screens/**",
                      "#screens",
                      "./**/screens/**",
                      "./**/screens",
                      "../**/screens/**",
                      "../**/screens"
                    ],
                    "message": "Only the map of screens imports a screen."
                  },
                  {
                    "group": [
                      "#components/**",
                      "#components",
                      "./**/components/**",
                      "./**/components",
                      "../**/components/**",
                      "../**/components"
                    ],
                    "message": "A hook, loader or command may not import a component."
                  },
                  {
                    "group": ["#(dev)/**", "#(dev)", "./**/(dev)/**", "./**/(dev)", "../**/(dev)/**", "../**/(dev)"],
                    "message": "Only screens import (dev)/."
                  },
                  {
                    "group": [
                      "#(prototype)/**",
                      "#(prototype)",
                      "./**/(prototype)/**",
                      "./**/(prototype)",
                      "../**/(prototype)/**",
                      "../**/(prototype)"
                    ],
                    "message": "Only screens import (prototype)/."
                  },
                  {
                    "group": [
                      "**/*.test",
                      "**/*.test.*",
                      "**/*.spec",
                      "**/*.spec.*",
                      "**/*.story",
                      "**/*.story.*",
                      "**/*.fixture",
                      "**/*.fixture.*",
                      "#storybook/**",
                      "#storybook",
                      "./**/storybook/**",
                      "./**/storybook",
                      "../**/storybook/**",
                      "../**/storybook",
                      "@kodogu/desktop-foundation/storybook/**",
                      "@kodogu/desktop-foundation/storybook"
                    ],
                    "message": "Production code may not import tests, stories, fixtures or the shared preview of Storybook."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Commands
    {
      "includes": [
        "apps/desktop/*/src/commands/**",
        "tools/*/desktop/src/commands/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.story.*",
        "!**/*.fixture.*",
        "!apps/desktop/foundation/src/storybook/**",
        "!apps/desktop/dependency-fixtures/src/storybook/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#screens/**",
                      "#screens",
                      "./**/screens/**",
                      "./**/screens",
                      "../**/screens/**",
                      "../**/screens"
                    ],
                    "message": "Only the map of screens imports a screen."
                  },
                  {
                    "group": [
                      "#components/**",
                      "#components",
                      "./**/components/**",
                      "./**/components",
                      "../**/components/**",
                      "../**/components"
                    ],
                    "message": "A hook, loader or command may not import a component."
                  },
                  {
                    "group": ["#hooks/**", "#hooks", "./**/hooks/**", "./**/hooks", "../**/hooks/**", "../**/hooks"],
                    "message": "A command may not import a hook."
                  },
                  {
                    "group": ["#(dev)/**", "#(dev)", "./**/(dev)/**", "./**/(dev)", "../**/(dev)/**", "../**/(dev)"],
                    "message": "Only screens import (dev)/."
                  },
                  {
                    "group": [
                      "#(prototype)/**",
                      "#(prototype)",
                      "./**/(prototype)/**",
                      "./**/(prototype)",
                      "../**/(prototype)/**",
                      "../**/(prototype)"
                    ],
                    "message": "Only screens import (prototype)/."
                  },
                  {
                    "group": [
                      "**/*.test",
                      "**/*.test.*",
                      "**/*.spec",
                      "**/*.spec.*",
                      "**/*.story",
                      "**/*.story.*",
                      "**/*.fixture",
                      "**/*.fixture.*",
                      "#storybook/**",
                      "#storybook",
                      "./**/storybook/**",
                      "./**/storybook",
                      "../**/storybook/**",
                      "../**/storybook",
                      "@kodogu/desktop-foundation/storybook/**",
                      "@kodogu/desktop-foundation/storybook"
                    ],
                    "message": "Production code may not import tests, stories, fixtures or the shared preview of Storybook."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Components
    {
      "includes": [
        "apps/desktop/*/src/components/**",
        "tools/*/desktop/src/components/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.story.*",
        "!**/*.fixture.*",
        "!apps/desktop/foundation/src/storybook/**",
        "!apps/desktop/dependency-fixtures/src/storybook/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#screens/**",
                      "#screens",
                      "./**/screens/**",
                      "./**/screens",
                      "../**/screens/**",
                      "../**/screens"
                    ],
                    "message": "Only the map of screens imports a screen."
                  },
                  {
                    "group": ["#(dev)/**", "#(dev)", "./**/(dev)/**", "./**/(dev)", "../**/(dev)/**", "../**/(dev)"],
                    "message": "Only screens import (dev)/."
                  },
                  {
                    "group": [
                      "#(prototype)/**",
                      "#(prototype)",
                      "./**/(prototype)/**",
                      "./**/(prototype)",
                      "../**/(prototype)/**",
                      "../**/(prototype)"
                    ],
                    "message": "Only screens import (prototype)/."
                  },
                  {
                    "group": [
                      "**/*.test",
                      "**/*.test.*",
                      "**/*.spec",
                      "**/*.spec.*",
                      "**/*.story",
                      "**/*.story.*",
                      "**/*.fixture",
                      "**/*.fixture.*",
                      "#storybook/**",
                      "#storybook",
                      "./**/storybook/**",
                      "./**/storybook",
                      "../**/storybook/**",
                      "../**/storybook",
                      "@kodogu/desktop-foundation/storybook/**",
                      "@kodogu/desktop-foundation/storybook"
                    ],
                    "message": "Production code may not import tests, stories, fixtures or the shared preview of Storybook."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Screens
    {
      "includes": [
        "apps/desktop/*/src/screens/**",
        "tools/*/desktop/src/screens/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.story.*",
        "!**/*.fixture.*",
        "!apps/desktop/foundation/src/storybook/**",
        "!apps/desktop/dependency-fixtures/src/storybook/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/*.test",
                      "**/*.test.*",
                      "**/*.spec",
                      "**/*.spec.*",
                      "**/*.story",
                      "**/*.story.*",
                      "**/*.fixture",
                      "**/*.fixture.*",
                      "#storybook/**",
                      "#storybook",
                      "./**/storybook/**",
                      "./**/storybook",
                      "../**/storybook/**",
                      "../**/storybook",
                      "@kodogu/desktop-foundation/storybook/**",
                      "@kodogu/desktop-foundation/storybook"
                    ],
                    "message": "Production code may not import tests, stories, fixtures or the shared preview of Storybook."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // (dev)/
    {
      "includes": [
        "apps/desktop/*/src/(dev)/**",
        "tools/*/desktop/src/(dev)/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.story.*",
        "!**/*.fixture.*",
        "!apps/desktop/foundation/src/storybook/**",
        "!apps/desktop/dependency-fixtures/src/storybook/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#(prototype)/**",
                      "#(prototype)",
                      "./**/(prototype)/**",
                      "./**/(prototype)",
                      "../**/(prototype)/**",
                      "../**/(prototype)"
                    ],
                    "message": "Only screens import (prototype)/."
                  },
                  {
                    "group": [
                      "**/*.test",
                      "**/*.test.*",
                      "**/*.spec",
                      "**/*.spec.*",
                      "**/*.story",
                      "**/*.story.*",
                      "**/*.fixture",
                      "**/*.fixture.*",
                      "#storybook/**",
                      "#storybook",
                      "./**/storybook/**",
                      "./**/storybook",
                      "../**/storybook/**",
                      "../**/storybook",
                      "@kodogu/desktop-foundation/storybook/**",
                      "@kodogu/desktop-foundation/storybook"
                    ],
                    "message": "Production code may not import tests, stories, fixtures or the shared preview of Storybook."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // (prototype)/
    {
      "includes": [
        "apps/desktop/*/src/(prototype)/**",
        "tools/*/desktop/src/(prototype)/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.story.*",
        "!**/*.fixture.*",
        "!apps/desktop/foundation/src/storybook/**",
        "!apps/desktop/dependency-fixtures/src/storybook/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#(dev)/**", "#(dev)", "./**/(dev)/**", "./**/(dev)", "../**/(dev)/**", "../**/(dev)"],
                    "message": "Only screens import (dev)/."
                  },
                  {
                    "group": [
                      "**/*.test",
                      "**/*.test.*",
                      "**/*.spec",
                      "**/*.spec.*",
                      "**/*.story",
                      "**/*.story.*",
                      "**/*.fixture",
                      "**/*.fixture.*",
                      "#storybook/**",
                      "#storybook",
                      "./**/storybook/**",
                      "./**/storybook",
                      "../**/storybook/**",
                      "../**/storybook",
                      "@kodogu/desktop-foundation/storybook/**",
                      "@kodogu/desktop-foundation/storybook"
                    ],
                    "message": "Production code may not import tests, stories, fixtures or the shared preview of Storybook."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // The route definitions, without router.ts
    {
      "includes": [
        "apps/desktop/routing/src/**",
        "apps/desktop/dependency-fixtures/routing/src/**",
        "!apps/desktop/routing/src/router.ts",
        "!apps/desktop/dependency-fixtures/routing/src/router.ts",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.story.*",
        "!**/*.fixture.*",
        "!apps/desktop/foundation/src/storybook/**",
        "!apps/desktop/dependency-fixtures/src/storybook/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**/gen/**", "./**/gen", "../**/gen/**", "../**/gen"],
                    "message": "Only router.ts imports the generated route tree."
                  },
                  {
                    "group": ["#(dev)/**", "#(dev)", "./**/(dev)/**", "./**/(dev)", "../**/(dev)/**", "../**/(dev)"],
                    "message": "Only screens import (dev)/."
                  },
                  {
                    "group": [
                      "#(prototype)/**",
                      "#(prototype)",
                      "./**/(prototype)/**",
                      "./**/(prototype)",
                      "../**/(prototype)/**",
                      "../**/(prototype)"
                    ],
                    "message": "Only screens import (prototype)/."
                  },
                  {
                    "group": [
                      "**/*.test",
                      "**/*.test.*",
                      "**/*.spec",
                      "**/*.spec.*",
                      "**/*.story",
                      "**/*.story.*",
                      "**/*.fixture",
                      "**/*.fixture.*",
                      "#storybook/**",
                      "#storybook",
                      "./**/storybook/**",
                      "./**/storybook",
                      "../**/storybook/**",
                      "../**/storybook",
                      "@kodogu/desktop-foundation/storybook/**",
                      "@kodogu/desktop-foundation/storybook"
                    ],
                    "message": "Production code may not import tests, stories, fixtures or the shared preview of Storybook."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
